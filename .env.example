# Initialize with scripts/init.ps1 (Windows) or scripts/init.sh (Ubuntu).
BIND_IP=127.0.0.1
# Host data directory. Relative paths are resolved from this project directory.
WORKSPACE_DIR=./workspace
NOTEBOOK_PORT=8888
KESTRA_PORT=8082
SQL_BIND_IP=127.0.0.1
SQL_PORT=10000
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
# Compose derives AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY for Spark S3A.
# Keep credential values only in these R2_* fields.
R2_BUCKET=CHANGE_ME
# Leave empty to derive the standard R2 endpoint.
S3_ENDPOINT=
DEFAULT_CATALOG=lakehouse
DEFAULT_SCHEMA=default
# Create the starter project/flow only when absent. Never run it automatically.
SEED_SAMPLE_DBT=true
# Portable UC definitions on R2, independent of PostgreSQL volume lifetime.
UC_REGISTRY_ENABLED=true
UC_REGISTRY_PREFIX=_lakehouse/registry/v1
# Reconciliation also captures direct/internal UC API changes between polls.
UC_REGISTRY_SYNC_SECONDS=60
REGISTRY_MEMORY=256m
SPARK_THREADS=auto
SPARK_DRIVER_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=8
NOTEBOOK_MEMORY=6g
SQL_MEMORY=6g
RUNNER_MEMORY=6g
KESTRA_MEMORY=4g
KESTRA_JAVA_OPTS=-Xms256m -Xmx2g -XX:ActiveProcessorCount=2
JUPYTER_TOKEN=GENERATE
RUNNER_TOKEN=GENERATE
POSTGRES_PASSWORD=GENERATE
KESTRA_USER=admin@example.com
KESTRA_PASSWORD=GENERATE
BACKUP_PREFIX=platform-backups/v3
# Optional multiuser JupyterHub (see docs/MULTIUSER.md)
HUB_ADMIN=admin

# IANA timezone. init.sh detects the Ubuntu host timezone on a fresh installation.
TZ=Asia/Ho_Chi_Minh
# Operational artifacts only. Table data and catalog metadata are never purged here.
RUN_RETENTION_DAYS=30
RUN_STORAGE_MAX_GB=10
HISTORY_RETENTION_DAYS=365
RUN_LOG_MAX_MB=25
KESTRA_RETENTION_DAYS=30

# Maximum artifacts per running job; checked every 5 seconds.
RUN_ARTIFACT_MAX_MB=1024
